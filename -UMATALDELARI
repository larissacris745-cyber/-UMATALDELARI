    <section id="projetos">
        <h2>Meus Projetos</h2>
        <div class="projects-grid">
            <div class="project-card">
                <h3>Projeto 1</h3>
                <p>Breve descrição do seu projeto, tecnologias utilizadas e o resultado alcançado.</p>
            </div>
            <div class="project-card">
                <h3>Projeto 2</h3>
                <p>Breve descrição do seu projeto, tecnologias utilizadas e o resultado alcançado.</p>
            </div>
            <div class="project-card">
                <h3>Projeto 3</h3>
                <p>Breve descrição do seu projeto, tecnologias utilizadas e o resultado alcançado.</p>
            </div>
        </div>
    </section>

    <section id="contato" style="text-align: center;">
        <h2>Vamos conversar?</h2>
        <p class="contact-info">Estou à disposição para novos desafios e oportunidades. Entre em contato!</p>
        
        <a href="mailto:larissacris745@gmail.com" class="btn">Enviar E-mail</a>
        <a href="https://wa.me/5511933376842" target="_blank" class="btn" style="background-color: #22c55e; color: #fff;">WhatsApp</a>
        <a href="https://instagram.com/umataldelari_" target="_blank" class="btn" style="background-color: #e11d48; color: #fff;">Instagram</a>
    </section>

    <footer>
        <p>&copy; 2026 Larissa Cristina Pereira. Todos os direitos reservados.</p>
    </footer>

</body>
</html>
